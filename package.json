    "clsx": "^2.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.263.1",
    "nodemailer": "^8.0.7",
    "playwright": "^1.40.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.15.0",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
